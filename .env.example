# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables. Never commit real values.

# Access (docs/DECISIONS.md D9). Changing either value signs you out.
PULSE_PASSCODE=
# Long random string, e.g. the output of `openssl rand -hex 32`
PULSE_SESSION_SECRET=

# Database (Neon Postgres via the Vercel Marketplace sets this for you)
DATABASE_URL=

# Monthly budget for all APIs combined, in USD (default 20)
PULSE_MONTHLY_BUDGET_USD=20

# Pseudonymizes author handles. Set once and never change it.
AUTHOR_HASH_SALT=

# AI: Claude and Jev through Vercel AI Gateway (used from Phase 1 step 3)
AI_GATEWAY_API_KEY=

# Sources (used from Phase 1 step 2)
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
APIFY_TOKEN=
SCRAPECREATORS_API_KEY=
